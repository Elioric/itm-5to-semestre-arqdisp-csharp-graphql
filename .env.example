# Archivo de ejemplo de variables de entorno
# Copia este archivo a .env y ajusta los valores según tu configuración

# Puerto del servidor
PORT=4000

# Configuración de MongoDB
MONGO_URI=mongodb://admin:secret@localhost:27017
DB_NAME=boardgamesdb

# API de países
# URL de la API de países que se usará para validación
COUNTRIES_API_URL=https://api.sampleapis.com/countries/countries

# Configuración de timeouts y cache

# Timeout para peticiones HTTP a la API de países (en milisegundos)
COUNTRIES_API_TIMEOUT=5000

# Duración del cache de países (en milisegundos)
# 86400000 = 24 horas
# 3600000 = 1 hora  
# 1800000 = 30 minutos
COUNTRIES_CACHE_DURATION=86400000

# Ejemplos de otras APIs de países que podrías usar:
# COUNTRIES_API_URL=https://restcountries.com/v3.1/all
# COUNTRIES_API_URL=https://api.first.org/data/v1/countries
